# Groq API Key (Primary)
GROQ_API_KEY=your_groq_api_key_here

# Deepgram API Key (Fallback)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Allowed Origin (Frontend URL)
# For local dev: http://localhost:5500 or similar
# For production: https://yourdomain.com
ALLOWED_ORIGIN=*

# Google Drive Integration (optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Maximum upload size in MB
MAX_UPLOAD_MB=50

# Optional local Ollama fallback (only needed if Groq fails)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:31b-cloud

# Secret key for JWT token signing
JWT_SECRET_KEY=change_this_to_a_long_random_string